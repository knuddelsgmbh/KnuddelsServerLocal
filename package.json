{
  "name": "knuddels-userapp-test-env",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lokale Test-Umgebung für Knuddels UserApps",
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,magenta \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:local": "npm run dev",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:ui": "vite --config src/debug-ui/vite.config.ts",
    "build:ui": "vite build --config src/debug-ui/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "cross-spawn": "^7.0.6",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
